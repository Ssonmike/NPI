{
  "name": "pallet-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.viewer.js",
    "dev:viewer": "vite --config vite.config.viewer.js",
    "dev:admin": "vite --config vite.config.admin.js",
    "dev:all": "concurrently \"npm run dev:viewer\" \"npm run dev:admin\" \"npm run server\"",
    "build": "vite build --config vite.config.viewer.js && vite build --config vite.config.admin.js",
    "build:viewer": "vite build --config vite.config.viewer.js",
    "build:admin": "vite build --config vite.config.admin.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "nodemon server/server.js",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@react-three/drei": "9.117.0",
    "@react-three/fiber": "8.17.10",
    "@types/three": "0.170.0",
    "autoprefixer": "^10.4.23",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "lucide-react": "^0.562.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "postcss": "^8.5.6",
    "ra-data-simple-rest": "^5.14.1",
    "react": "18.3.1",
    "react-admin": "^5.14.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "three": "0.170.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.0.2",
    "vite": "^7.2.4"
  }
}